digraph G {graph [fontname="DejaVu Sans",rankdir=LR,nodesep="0.35",ranksep="0.65",bgcolor="white"];node [fontname="DejaVu Sans",fontsize=11];User [shape=box,style="rounded,filled",fillcolor="#DDEAD8",label="User"];Reviewer [shape=box,style="rounded,filled",fillcolor="#F5EBC9",label="Evaluator"];subgraph cluster_system {label="Kazakh Voice Control (planned MVP)";fontname="DejaVu Sans";color="#9DB7D8";style="rounded";U1 [shape=ellipse,label="Provide speech / text"];U2 [shape=ellipse,label="Review transcript"];U3 [shape=ellipse,label="Execute allowed action"];U4 [shape=ellipse,label="Handle unsupported intent"];U5 [shape=ellipse,label="Review benchmark metrics"];};User->U1;User->U2;User->U3;User->U4;Reviewer->U5;}